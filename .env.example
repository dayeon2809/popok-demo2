# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin — single shared password, not tied to any Supabase user/email.
# See lib/admin.ts. Both are server-only (no NEXT_PUBLIC_ prefix) and
# required for /admin and /api/admin/** to work at all.
ADMIN_PASSWORD=
# Long random string used to HMAC-sign the admin session cookie, e.g.
# `openssl rand -hex 32`. Changing it invalidates all existing sessions.
ADMIN_SESSION_SECRET=

# OpenAI (AI profile parsing / structuring)
OPENAI_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
POPOK_EMAIL_FROM=

# Analytics
NEXT_PUBLIC_GA_ID=

# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SHOW_DRAFT_ARTISTS=

# Instagram (@popok.official) — homepage "이주의 소식" section.
# Requires a Business/Creator Instagram account using "Instagram API with
# Instagram Login" (graph.instagram.com), not the older Facebook-Page-linked
# Graph API. See lib/instagram.ts for how these are used. Section is hidden
# automatically (dev shows a notice, production shows nothing) if unset.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
